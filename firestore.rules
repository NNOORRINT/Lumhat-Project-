rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Exam config (portal landing page) ───────────────────────────────────
    // Anyone can read (needed to show the portal). Only admins can write.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Participants ─────────────────────────────────────────────────────────
    // Public read so the portal can verify a contestant ID without login.
    // Only admins can add / remove participants.
    match /participants/{contestantId} {
      allow read:   if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Submissions ──────────────────────────────────────────────────────────
    // A contestant can create their own submission only if their ID exists in
    // the participants collection (prevents random writes).
    // Admins can read all submissions and update/delete if needed.
    match /submissions/{contestantId} {
      allow read:   if isAdmin() || true;   // admin reads all; contestant checks own
      allow create: if exists(/databases/$(database)/documents/participants/$(contestantId));
      allow update, delete: if isAdmin();
    }

    // ── Presence (live heartbeat) ────────────────────────────────────────────
    // Contestants write their own heartbeat; only admins read.
    match /presence/{docId} {
      allow read:  if isAdmin();
      allow write: if true;
    }

    // ── Admins ───────────────────────────────────────────────────────────────
    // Any authenticated user can read their own admin doc (needed for the
    // "is this user an admin?" check in the nav). Only existing admins can
    // grant or revoke admin access.
    match /admins/{uid} {
      allow read:   if request.auth != null;
      allow write, delete: if isAdmin();
    }

    // ── Users (main LumHat site) ─────────────────────────────────────────────
    // Users can read/write only their own profile document.
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Community / forum & contest collections ──────────────────────────────
    match /posts/{document=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /threads/{document=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /contestCollections/{document=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /collectionYears/{document=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /collectionProblems/{document=**} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /registrations/{document=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Catch-all: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
